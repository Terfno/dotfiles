{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/**)",
      "Read(~/.zshrc)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(npm run lint *)",
      "Bash(npm run test *)",
      "Bash(* --version)",
      "Bash(gh wt *)",
      "WebFetch(domain:example.com)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(rm:*)",
      "Bash(npm run *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(git push *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "alwaysThinkingEnabled": true
}
