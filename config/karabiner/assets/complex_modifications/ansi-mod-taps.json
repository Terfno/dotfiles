{
    "title": "ANSI mod-taps",
    "rules": [
        {
            "description": "ANSI lr-cmdkey to eisu/kana, azxc;/., to shift,option,cmd",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "left_command",
                        "modifiers": {
                            "optional": ["any"]
                        }
                    },
                    "to_if_alone": {
                        "halt": true,
                        "key_code": "japanese_eisuu"
                    },
                    "to_delayed_action": {
                        "to_if_canceled": [
                            {
                                "key_code": "japanese_eisuu"
                            }
                        ]
                    },
                    "to_if_held_down": {
                        "halt": true,
                        "key_code": "left_command"
                    }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_command",
                        "modifiers": {
                            "optional": ["any"]
                        }
                    },
