#!/bin/sh

# vendored from: https://github.com/k0kubun/dotfiles/blob/bf7e5c3a456bad3824d8bbab1e61d8893070a2b0/bin/setup
# original license: MIT, https://github.com/k0kubun/dotfiles/blob/bf7e5c3a456bad3824d8bbab1e61d8893070a2b0/LICENSE.txt

set -e

mitamae_version="2.0.0"
mitamae_x86_64_linux_sha256="e63821869c787c85c43ae0ebb7e5dec2c1bc00d4ea8efce272d646080e6baa97"
mitamae_aarch64_linux_sha256="21c5d27efc5f2858cfe8dd180a50b75ff80546d851e579cd7ad9c623b3767c42"
mitamae_x86_64_darwin_sha256="5074baba52a3ae3855f6b7711735f8004db2b2b6de3ddf346d6c34ed542256a7"
mitamae_aarch64_darwin_sha256="090c6a4499235d79191632188c70846de93a7e2c77f9077ef61b530149209218"

case "$(uname)-$(uname -m)" in
  "Linux-x86_64")
    mitamae_bin="mitamae-x86_64-linux"
    mitamae_sha256="$mitamae_x86_64_linux_sha256"
    ;;
  "Linux-arm64"|"Linux-aarch64")
    mitamae_bin="mitamae-aarch64-linux"
    mitamae_sha256="$mitamae_aarch64_linux_sha256"
    ;;
  "Darwin-x86_64")
    mitamae_bin="mitamae-x86_64-darwin"
    mitamae_sha256="$mitamae_x86_64_darwin_sha256"
    ;;
  "Darwin-arm64")
    mitamae_bin="mitamae-aarch64-darwin"
    mitamae_sha256="$mitamae_aarch64_darwin_sha256"
    ;;
  *)
    echo "unexpected platform: $(uname)-$(uname -m)"
    exit 1
    ;;
esac

mitamae_cache="mitamae-${mitamae_version}-$(uname)-$(uname -m)"
if ! [ -f "bin/${mitamae_cache}" ]; then
  curl -o "bin/${mitamae_cache}" -fL "https://github.com/itamae-kitchen/mitamae/releases/download/v${mitamae_version}/${mitamae_bin}"
  sha256="$(/usr/bin/openssl dgst -sha256 "bin/${mitamae_cache}" | cut -d" " -f2)"
  if [ "$mitamae_sha256" != "$sha256" ]; then
    echo "checksum verification failed!\nexpected: ${mitamae_sha256}\n  actual: ${sha256}"
    rm "bin/${mitamae_cache}"
    exit 1
  fi
  chmod +x "bin/${mitamae_cache}"
fi
ln -sf "${mitamae_cache}" bin/mitamae
