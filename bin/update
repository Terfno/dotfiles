#!/usr/bin/env ruby
# frozen_string_literal: true

# vendored from: https://github.com/k0kubun/dotfiles/blob/bf7e5c3a456bad3824d8bbab1e61d8893070a2b0/bin/update
# original license: MIT, https://github.com/k0kubun/dotfiles/blob/bf7e5c3a456bad3824d8bbab1e61d8893070a2b0/LICENSE.txt

require 'net/http'
require 'json'
require 'shellwords'
require 'fileutils'

class GitHubRepository
  # @param [String] full_name - "user/repo"
  def initialize(full_name)
    @full_name = full_name
  end

  # @return [String] - "1.2.3"
  def latest_version
    @latest_version ||= latest_release.fetch('tag_name').sub(/\Av/, '')
  end

  def latest_sha256_for(asset_name)
    temp_path = nil
    asset = latest_release.fetch('assets').find { |a| a.fetch('name') == asset_name }
    raise "Failed to find asset: #{asset_name}" if asset.nil?

    digest = asset['digest']
    if digest&.start_with?('sha256:')
      return digest.delete_prefix('sha256:')
    end

    temp_path = "/tmp/#{asset_name}"
    unless system(['curl', '-o', temp_path, '-fL', asset.fetch('browser_download_url')].shelljoin)
      raise "Failed to fetch asset: #{asset_name}"
    end

    result = IO.popen(['shasum', '-a', '256', temp_path], &:read)
    sha256 = result.sub!(/ +#{Regexp.escape(temp_path)}\n\z/m, '')
    raise "Failed to fetch sha256 from: #{result}" if sha256.nil?

    sha256
  ensure
    FileUtils.rm_f(temp_path) unless temp_path.nil?
  end

  private

  def latest_release
    @latest_release ||= begin
      response = Net::HTTP.start('api.github.com', 443, use_ssl: true) do |http|
        http.get("/repos/#{@full_name}/releases/latest")
      end

      unless response.is_a?(Net::HTTPSuccess)
        require 'pp'
        pp response.to_hash
        raise 'GitHub responded unexpectedly!'
      end

      JSON.parse(response.body)
    end
  end
end

repo = GitHubRepository.new('itamae-kitchen/mitamae')
version = repo.latest_version
x86_64_linux_shasum = repo.latest_sha256_for('mitamae-x86_64-linux')
aarch64_linux_shasum = repo.latest_sha256_for('mitamae-aarch64-linux')
x86_64_darwin_shasum = repo.latest_sha256_for('mitamae-x86_64-darwin')
aarch64_darwin_shasum = repo.latest_sha256_for('mitamae-aarch64-darwin')

setup_file = "#{__dir__}/bootstrap-mitamae"
source = File.read(setup_file)
source.sub!(/^(mitamae_version=).+$/, %(\\1"#{version}"))
source.sub!(/^(mitamae_x86_64_linux_sha256=).+$/, %(\\1"#{x86_64_linux_shasum}"))
source.sub!(/^(mitamae_aarch64_linux_sha256=).+$/, %(\\1"#{aarch64_linux_shasum}"))
source.sub!(/^(mitamae_x86_64_darwin_sha256=).+$/, %(\\1"#{x86_64_darwin_shasum}"))
source.sub!(/^(mitamae_aarch64_darwin_sha256=).+$/, %(\\1"#{aarch64_darwin_shasum}"))
File.write(setup_file, source)
